  "name": "Central de Ajuda - Wizebot",
  "description": "Documentação oficial da WizeBot - Plataforma de automação de WhatsApp Business com API Oficial da Meta. Aprenda a configurar, automatizar e integrar seu WhatsApp de forma profissional.",
  "colors": {
    "primary": "#2563eb",
    "light": "#3b82f6",
    "dark": "#1d4ed8"
  },
  "favicon": "/favicon.svg",
