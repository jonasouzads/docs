              "PATCH /whatsapp/contacts/custom-fields"
            ]
          },
          {
            "group": "WhatsApp · Etiquetas",
            "icon": "tag",
            "pages": [
              "GET /whatsapp/tags",
              "POST /whatsapp/tags",
              "POST /whatsapp/contacts/tags",
              "DELETE /whatsapp/contacts/tags"
            ]
          },
          {
            "group": "WhatsApp · Sequências",
            "icon": "clock",
            "pages": [
              "GET /whatsapp/sequences/status",
              "POST /whatsapp/sequences/cancel"
            ]
          },
          {
            "group": "WhatsApp · Conta",
            "icon": "key",
            "pages": [
              "GET /whatsapp/ping"
            ]
          }
        ]
      },
      {
        "group": "Novidades",
        "icon": "sparkle",
        "pages": [
          "changelog/atualizacoes"
        ]
      },
      {
        "group": "Suporte",
        "icon": "life-ring",
        "pages": [
          "tutoriais/solucao-problemas/suporte"
        ]
      }
    ],
    "global": {
      "anchors": [
        {
          "anchor": "Blog",
          "href": "https://wizebot.com.br/blog",
          "icon": "newspaper"
        },
        {
          "anchor": "WhatsApp",
          "href": "https://wa.me/559192226534",
          "icon": "whatsapp"
        }
      ]
    }
  },
  "logo": {
    "light": "/images/logo-wizebot-dark.png",
    "dark": "/images/logo-wizebot-white.png",
    "href": "https://app.wizebot.com.br",
    "size": 180
  },
  "api": {
    "playground": {
      "display": "interactive",
      "proxy": true
    },
    "examples": {
      "languages": [
        "bash",
        "javascript",
        "node",
        "python",
        "php"
      ],
      "defaults": "required",
      "prefill": true
    },
    "mdx": {
      "server": "https://api.wizebot.com.br/v1"
    }
  },
  "appearance": {
    "default": "light",
    "strict": false
  },
  "background": {
    "default": "#fff"
  },
  "navbar": {
    "links": [
      {
        "label": "Acessar Wizebot",
        "href": "https://app.wizebot.com.br"
      },
      {
        "label": "Suporte",
        "href": "https://wa.me/559192226534"
      }
    ]
  },
  "footer": {
    "socials": {
      "instagram": "https://www.instagram.com/wizebotbr",
      "facebook": "https://www.facebook.com/wizebotbr",
      "linkedin": "https://www.linkedin.com/company/wizebot"
    }
  },
  "seo": {
    "metatags": {
      "og:image": "https://app.wizebot.com.br/images/og-image.png",
      "og:site_name": "Central de Ajuda - WizeBot",
      "twitter:site": "@wizebotbr"
    }
  },
  "contextual": {
    "options": [
      "copy",
      "view",
      "chatgpt",
      "claude"
    ]
  },
  "errors": {
    "404": {
      "title": "Página não encontrada",
      "description": "A página que você procura não existe ou foi movida. Volte para a [página inicial](/) ou use a busca para encontrar o que precisa."
    }
  },
