            ]
          },
          "tutoriais/api/migracao-v2-api-whatsapp"
        ]
      },
      {
        "group": "Referência da API",
        "icon": "terminal",
        "openapi": "openapi.json",
        "pages": [
          "api-reference/introducao",
          {
            "group": "Contrato multicanal",
            "icon": "share-nodes",
            "pages": [
              "GET /channels",
              "POST /messages",
              "GET /messages/{message_id}"
            ]
          },
          {
            "group": "WhatsApp · Mensagens",
            "icon": "paper-plane",
            "pages": [
              "POST /whatsapp/messages",
              "GET /whatsapp/messages/{message_id}/status",
              "GET /whatsapp/templates"
            ]
          },
          {
            "group": "WhatsApp · Contatos",
            "icon": "users",
            "pages": [
              "GET /whatsapp/contacts",
              "GET /whatsapp/contacts/lookup",
              "POST /whatsapp/contacts",
              "PATCH /whatsapp/contacts",
              "DELETE /whatsapp/contacts",
